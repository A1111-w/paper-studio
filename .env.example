# Web
VITE_API_BASE_URL=http://localhost:3100
VITE_BOOK_SITE_URL=https://books.example.com
VITE_DEMO_MODE=true

# API
HOST=127.0.0.1
PORT=3100
API_PORT=3100
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
DEMO_USER_EMAIL=writer@local.test
DEMO_USER_PASSWORD=replace-demo-user-password
DEMO_ADMIN_EMAIL=admin@local.test
DEMO_ADMIN_PASSWORD=replace-demo-admin-password
DEMO_AUTH_ENABLED=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
AI_MOCK_MODE=true
AI_MAX_CONCURRENCY=3
AI_REQUEST_TIMEOUT_MS=90000
OUTPUT_DIR=./storage/generated

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional approved relay. Never accept a base URL from end users.
RELAY_API_KEY=
RELAY_BASE_URL=
RELAY_MODEL=
RELAY_ALLOWED_HOSTS=

# Queue infrastructure. Keep REDIS_URL empty for local inline mode.
REDIS_URL=
REDIS_PASSWORD=replace-with-a-strong-redis-password
GENERATION_QUEUE_NAME=wenhe-generation
WEB_PUBLIC_URL=http://localhost:8080
